# このファイルを .env にコピーして、使う LLM の設定を 1 つ書いてください。
#   cp .env.example .env

# ─── どの LLM を使うか ─────────────────────────────────────────
# openai | anthropic | ollama（空なら API キーから自動判定: OpenAI → Anthropic → Ollama）
LLM_PROVIDER=

# ─── OpenAI（mem0 の既定。LLM と埋め込みの両方を OpenAI で） ───
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# temperature を受け付けない推論モデルかどうか（1/0）。空なら自動判定
# 「'temperature' does not support 0.1」エラーが出たら 1 にする
# OPENAI_REASONING_MODEL=

# ─── Anthropic（Claude）────────────────────────────────────────
# Anthropic には埋め込み API が無いので、埋め込みはローカルの fastembed を使います
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# 会話の思考の深さ: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=low
# 安全分類器による拒否時のサーバーサイド・フォールバック（1=有効, 0=無効）
# ANTHROPIC_FALLBACKS=1

# ─── Ollama（ローカル LLM・無料）───────────────────────────────
# 事前に `ollama pull qwen3:8b` などでモデルを取得しておく
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# ─── mem0 が「事実の抽出」に使うモデル（空ならエージェントと同じ） ──
# 抽出は小さめのモデルでも十分なことが多い（コスト・速度の調整用）
# MEMORY_LLM_MODEL=

# ─── 埋め込み（テキスト→ベクトル）───────────────────────────────
# openai | fastembed | ollama（空なら OpenAI 使用時は openai、それ以外は fastembed）
# EMBEDDER_PROVIDER=
# FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 一覧にない埋め込みモデルを使うときは次元数を指定
# EMBEDDING_DIMS=

# 記憶の保存先（既定: ./data）
# DATA_DIR=
